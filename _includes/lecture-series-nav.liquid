{% for path_id in page.lecture_paths %}
  {% assign lecture_path = site.data.lecture_paths[path_id] %}
  {% assign current_index = nil %}
  {% for chapter in lecture_path.chapters %}
    {% if chapter.post == page.slug %}
      {% assign current_index = forloop.index0 %}
    {% endif %}
  {% endfor %}

  {% if current_index != nil %}
    {% assign previous_index = current_index | minus: 1 %}
    {% assign next_index = current_index | plus: 1 %}
    <nav class="lecture-series-nav" aria-label="{{ lecture_path.title }} reading path">
      <div class="lecture-series-nav__position">
        Chapter {{ current_index | plus: 1 }} of {{ lecture_path.chapters.size }} in
        <a href="{{ lecture_path.permalink | relative_url }}">{{ lecture_path.short_title }}</a>
      </div>
      <div class="lecture-series-nav__links">
        {% if current_index > 0 %}
          {% assign previous_chapter = lecture_path.chapters[previous_index] %}
          {% assign previous_post = site.posts | where: 'slug', previous_chapter.post | first %}
          {% if previous_post %}
            <a class="lecture-series-nav__previous" href="{{ previous_post.url | relative_url }}">
              <span aria-hidden="true">←</span>
              <span><small>Previous</small>{{ previous_post.title }}</span>
            </a>
          {% else %}
            <span></span>
          {% endif %}
        {% else %}
          <span></span>
        {% endif %}
        {% if next_index < lecture_path.chapters.size %}
          {% assign next_chapter = lecture_path.chapters[next_index] %}
          {% assign next_post = site.posts | where: 'slug', next_chapter.post | first %}
          {% if next_post %}
            <a class="lecture-series-nav__next" href="{{ next_post.url | relative_url }}">
              <span><small>Next</small>{{ next_post.title }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {% endif %}
        {% endif %}
      </div>
    </nav>
  {% endif %}
{% endfor %}
