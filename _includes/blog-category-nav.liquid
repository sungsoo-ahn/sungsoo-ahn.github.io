{% assign all_count = site.posts | size %}
{% assign selected_count = site.posts | where: "selected", true | size %}
{% assign human_reviewed_count = site.posts | where: "editorial_status", "human-reviewed" | size %}
{% assign ai_generated_count = site.posts | where: "editorial_status", "ai-generated" | size %}
{% assign research_count = site.posts | where: "post_type", "research" | size %}
{% assign tutorial_count = site.posts | where: "post_type", "tutorial" | size %}
{% assign technical_note_count = site.posts | where: "post_type", "technical-note" | size %}

<div class="blog-index-filters">
  <nav class="blog-type-summary blog-category-summary" aria-label="Blog collections">
    <span>Collections</span>
    <span>
      <a href="{{ '/blog/all/' | relative_url }}"{% if page.url == '/blog/all/' %} class="is-active" aria-current="page"{% endif %}>All posts {{ all_count }}</a>
    </span>
    <span>
      <a href="{{ '/blog/selected/' | relative_url }}"{% if page.url == '/blog/selected/' %} class="is-active" aria-current="page"{% endif %}>Selected {{ selected_count }}</a>
    </span>
    <span>
      <a href="{{ '/blog/human-reviewed/' | relative_url }}"{% if page.url == '/blog/human-reviewed/' %} class="is-active" aria-current="page"{% endif %}>Human-reviewed {{ human_reviewed_count }}</a>
    </span>
    <span>
      <a href="{{ '/blog/ai-generated/' | relative_url }}"{% if page.url == '/blog/ai-generated/' %} class="is-active" aria-current="page"{% endif %}>AI-generated {{ ai_generated_count }}</a>
    </span>
  </nav>
  <nav class="blog-type-summary blog-category-summary" aria-label="Blog formats">
    <span>Formats</span>
    <span>
      <a href="{{ '/blog/type/research/' | relative_url }}"{% if page.url == '/blog/type/research/' %} class="is-active" aria-current="page"{% endif %}>Research {{ research_count }}</a>
    </span>
    <span>
      <a href="{{ '/blog/type/tutorial/' | relative_url }}"{% if page.url == '/blog/type/tutorial/' %} class="is-active" aria-current="page"{% endif %}>Tutorials {{ tutorial_count }}</a>
    </span>
    <span>
      <a href="{{ '/blog/type/technical-note/' | relative_url }}"{% if page.url == '/blog/type/technical-note/' %} class="is-active" aria-current="page"{% endif %}>Technical notes {{ technical_note_count }}</a>
    </span>
  </nav>
  <nav class="blog-type-summary blog-category-summary" aria-label="Blog topics">
    <span>Topics</span>
    {% for category in site.data.blog_categories %}
      {% assign category_posts = site.categories[category.slug] %}
      {% assign category_post_count = category_posts.size | default: 0 %}
      {% assign category_url = category.slug | prepend: '/blog/category/' | append: '/' %}
      <span>
        <a href="{{ category_url | relative_url }}"{% if page.url == category_url %} class="is-active" aria-current="page"{% endif %}>{{ category.title }} {{ category_post_count }}</a>
      </span>
    {% endfor %}
  </nav>
</div>
