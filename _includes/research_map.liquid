<section
  id="research-map"
  class="research-map"
  aria-labelledby="research-map-title"
  data-source="{{ '/assets/json/research-map.json' | relative_url }}"
>
  <div class="rm-heading">
    <h2 id="research-map-title">Research</h2>
  </div>
  <p class="rm-introduction">
    We develop structured and probabilistic machine learning to infer, predict, and design molecular and material systems. Our goal is to expand what
    scientists can learn from experiments and simulations, and what they can investigate with that knowledge.
  </p>
  <div class="rm-map-frame">
    <div class="rm-overview rm-static">{% include research_map_overview.liquid %}</div>
    <div class="rm-legend" aria-label="Research categories">{% include research_map_legend.liquid %}</div>
  </div>
  <p class="rm-credit">
    Figure inspired by <a href="https://necludov.github.io/" target="_blank" rel="external nofollow noopener">Kirill Neklyudov</a>.
  </p>
  <p class="rm-status sr-only" role="status" aria-live="polite"></p>
  <p class="rm-load-status" role="status"></p>
</section>
