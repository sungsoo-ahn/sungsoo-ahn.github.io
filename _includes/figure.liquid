{% assign img_path = include.path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
{% assign parts = include.path | split: '.' %}
{% assign ext = parts.last %}
{% assign lecture_figure_registry = site.data.lecture_figure_sources %}
{% if lecture_figure_registry %}
  {% assign lecture_figure_source = lecture_figure_registry.figures[include.path] %}
{% endif %}

<figure
  {% if include.slot %}
    slot="{{ include.slot }}"
  {% endif %}
>
  <picture>
    <!-- Auto scaling with imagemagick -->
    <!--
      See https://www.debugbear.com/blog/responsive-images#w-descriptors-and-the-sizes-attribute and
      https://developer.mozilla.org/en-US/docs/Learn/HTML/Multimedia_and_embedding/Responsive_images for info on defining 'sizes' for responsive images
    -->
    {% if site.imagemagick.enabled %}
      {% unless include.avoid_scaling %}
        <source
          class="responsive-img-srcset"
          {% if ext == 'gif' or ext == 'jpeg' or ext == 'jpg' or ext == 'png' or ext == 'tiff' %}
            srcset="{% for i in site.imagemagick.widths %}{{ img_path | relative_url }}-{{ i }}.webp {{ i }}w,{% endfor %}"
            type="image/webp"
          {% else %}
            srcset="{{ include.path | relative_url }}"
          {% endif %}
          {% if include.sizes %}
            sizes="{{ include.sizes }}"
          {% else %}
            sizes="95vw"
          {% endif %}
        >
      {% endunless %}
    {% endif %}
    <img
      src="{% if include.url %}{{ include.url }}{% elsif include.cache_bust %}{{ include.path | relative_url | bust_file_cache }}{% else %}{{ include.path | relative_url }}{% endif %}"
      {% if include.class %}
        class="{{ include.class }}"
      {% endif %}
      {% if include.width %}
        width="{{ include.width }}"
      {% else %}
        width="100%"
      {% endif %}
      {% if include.height %}
        height="{{ include.height }}"
      {% else %}
        height="auto"
      {% endif %}
      {% if include['min-width'] or include['min-height'] or include['max-width'] or include['max-height'] %}
        style="
          {% if include['min-width'] %}
            min-width: {{ include.min-width }};
          {% endif %}
          {% if include['min-height'] %}
            min-height: {{ include.min-height }};
          {% endif %}
          {% if include['max-width'] %}
            max-width: {{ include.max-width }};
          {% endif %}
          {% if include['max-height'] %}
            max-height: {{ include.max-height }};
          {% endif %}
        "
      {% endif %}
      alt="{% if include.alt %}{{ include.alt | escape }}{% elsif include.caption %}{{ include.caption | strip_html | escape }}{% else %}Illustration{% endif %}"
      {% if include.title %}
        title="{{ include.title }}"
      {% endif %}
      {% if include.zoomable %}
        data-zoomable
      {% endif %}
      {% if include.loading %}
        loading="{{ include.loading }}"
      {% elsif site.lazy_loading_images %}
        loading="lazy"
      {% endif %}
      onerror="this.onerror=null; $('.responsive-img-srcset').remove();"
    >
  </picture>

  {% if include.caption or lecture_figure_source %}
    <figcaption class="caption">
      {% if include.caption %}{{ include.caption }}{% endif %}
      {% if lecture_figure_source and lecture_figure_source.status != 'pending' %}
        {% assign figure_source_count = lecture_figure_source.source_ids.size %}
        {% if figure_source_count > 0 %}
          <span class="figure-source">
            {% if lecture_figure_source.status == 'ambiguous' %}
              Possible {% if figure_source_count > 1 %}sources{% else %}source{% endif %}:
            {% else %}
              Figure {% if figure_source_count > 1 %}sources{% else %}source{% endif %}:
            {% endif %}
            {% for source_id in lecture_figure_source.source_ids %}
              {% assign source = lecture_figure_registry.sources[source_id] %}
              <a href="{{ source.url }}">{{ source.label }}</a>{% if source.license_status == 'open' %} ({{ source.license }}){% endif %}{% unless forloop.last %}; {% endunless %}
            {% endfor %}
            {% if lecture_figure_source.reader_note != '' %} {{ lecture_figure_source.reader_note }}{% endif %}
          </span>
        {% elsif lecture_figure_source.reader_note != '' %}
          <span class="figure-source">{{ lecture_figure_source.reader_note }}</span>
        {% endif %}
      {% endif %}
    </figcaption>
  {% endif %}
</figure>
