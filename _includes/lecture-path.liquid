{% assign lecture_path = site.data.lecture_paths[include.path_id] %}
{% if lecture_path %}
  {% assign published_count = 0 %}
  {% for chapter in lecture_path.chapters %}
    {% assign published_post = site.posts | where: 'slug', chapter.post | first %}
    {% if published_post %}
      {% assign published_count = published_count | plus: 1 %}
    {% endif %}
  {% endfor %}

  <div class="lecture-path">
    <p class="lecture-path__description">{{ lecture_path.description }}</p>
    <p class="lecture-path__count">{{ published_count }} of {{ lecture_path.chapters.size }} chapters published</p>

    {% assign path_sections = lecture_path.chapters | group_by: 'section' %}
    {% for path_section in path_sections %}
      <section class="lecture-path__section" aria-labelledby="lecture-path-{{ include.path_id }}-{{ forloop.index }}">
        <h2 id="lecture-path-{{ include.path_id }}-{{ forloop.index }}">{{ path_section.name }}</h2>
        <ol class="lecture-path__chapters">
          {% for chapter in path_section.items %}
            {% assign chapter_post = site.posts | where: 'slug', chapter.post | first %}
            <li{% unless chapter_post %} class="lecture-path__chapter--forthcoming"{% endunless %}>
              <div class="lecture-path__chapter-title">
                {% if chapter_post %}
                  <a href="{{ chapter_post.url | relative_url }}">{{ chapter_post.title }}</a>
                {% else %}
                  {{ chapter.title }}
                {% endif %}
              </div>
              {% if chapter_post and chapter_post.description %}
                <div class="lecture-path__chapter-description">{{ chapter_post.description }}</div>
              {% endif %}
              <div class="lecture-path__chapter-source">
                {{ chapter.source }}{% unless chapter_post %} · forthcoming{% endunless %}
              </div>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endfor %}
  </div>
{% endif %}
