      "pptx_slide": 7,
      "title": "Alexandria",
      "classification": "substantive",
      "coverage": "pending",
      "text": [
        "Alexandria",
        "• An open-access repository of millions of quantum chemistry calculations",
        "for molecules and materials.",
        "• Uniquely, Alexandria also stores information from the relaxation process –",
        "i.e. slightly off-equilibrium structures and the forces on atoms as the structure relaxes.",
        "• Not only final stable geometries, but also the paths the atoms take to get there."
      ],
      "media_sha256": [
        "38d74f0e3db2215b5a04d5950be3b7d8a8076c7425f953991501be436377a8ad"
