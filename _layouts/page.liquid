---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      <ol class="bibliography">
        {% for publication_id in page.related_publications %}
          {% assign related_publication = site.data.publications | where: 'id', publication_id | first %}
          {% if related_publication %}<li>{% include publication.liquid publication=related_publication %}</li>{% endif %}
        {% endfor %}
      </ol>
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
