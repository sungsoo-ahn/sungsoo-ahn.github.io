---
layout: default
---
<div class="post">
  <header class="post-header">
    {% assign archive_icon = page.icon | default: "fa-layer-group" %}
    <h1 class="post-title"><i class="fa-solid {{ archive_icon }} fa-sm"></i> {{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article class="archive publications blog-index">
    {% include blog-category-nav.liquid %}
    {% if page.post_type %}
      {% assign type_documents = site.posts | where: "post_type", page.post_type %}
    {% else %}
      {% assign type_documents = site.posts %}
    {% endif %}
    {% if page.sort_by == 'title' %}
      {% assign type_documents = type_documents | sort: 'title' %}
    {% else %}
      {% assign type_documents = type_documents | sort: 'date' | reverse %}
    {% endif %}
    {% assign archive_count = 0 %}
    <ol class="bibliography">
      {% for document in type_documents %}
        {% assign include_document = true %}
        {% if page.collection_status == 'selected' and document.selected != true %}
          {% assign include_document = false %}
        {% endif %}
        {% if include_document %}
          {% assign archive_count = archive_count | plus: 1 %}
          {% assign read_time = document.content | number_of_words | divided_by: 150 | plus: 1 %}
          <li>
            <div class="title">
              {% if document.redirect == blank %}
                <a href="{{ document.url | relative_url }}">{{ document.title }}</a>
              {% elsif document.redirect contains '://' %}
                <a href="{{ document.redirect }}" target="_blank" rel="noopener">{{ document.title }}</a>
              {% else %}
                <a href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
              {% endif %}
            </div>
            {% if document.description %}
              <div class="blog-list-description">{{ document.description }}</div>
            {% endif %}
            <div class="author">
              {% assign document_type = document.post_type | default: 'tutorial' | replace: '-', ' ' | capitalize %}
              {% if document.post_type == 'technical-note' %}{% assign document_type = 'Technical note' %}{% endif %}
              {{ document_type }} · Published {{ document.date | date: '%b %d, %Y' }}
              {% assign published_day = document.date | date: '%Y-%m-%d' %}
              {% assign updated_day = document.last_updated | date: '%Y-%m-%d' %}
              {% if document.last_updated and updated_day != published_day %} · Updated {{ document.last_updated | date: '%b %d, %Y' }}{% endif %}
              · {{ read_time }} min read
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
    {% if archive_count == 0 %}
      <p class="blog-empty-state">{{ page.empty_message | default: "No posts are in this category yet." }}</p>
    {% endif %}
  </article>
</div>
